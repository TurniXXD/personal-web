{
  "name": "vantuch-sites",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "pnpm --filter @vantuch/web dev",
    "dev:web": "pnpm --filter @vantuch/web dev",
    "dev:portfolio": "pnpm --filter @vantuch/portfolio dev",
    "build": "pnpm --filter @vantuch/portfolio build && pnpm --filter @vantuch/web build",
    "build:web": "pnpm --filter @vantuch/web build",
    "build:portfolio": "pnpm --filter @vantuch/portfolio build",
    "typecheck": "pnpm --filter @vantuch/portfolio typecheck && pnpm --filter @vantuch/web typecheck",
    "lint": "eslint apps packages",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @vantuch/portfolio test",
    "test:e2e": "pnpm --filter @vantuch/portfolio test:e2e && pnpm --filter @vantuch/web test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
