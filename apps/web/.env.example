# Public analytics identifiers are read on the server and inserted only after consent.
CLARITY_PROJECT_ID=
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Turnstile is inactive until keys are configured. Configure BOTH keys together.
# Verification secret must remain server-only.
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames accepted by Siteverify (add preview/local hosts explicitly).
TURNSTILE_ALLOWED_HOSTNAMES=vantuch.dev,www.vantuch.dev

# Sentry runtime and source-map upload configuration.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

RESEND_API_KEY=
RESEND_FROM_EMAIL="Jakub Vantuch <hello@vantuch.dev>"
RESEND_TO_EMAIL=contact@vantuch.dev
TWENTY_BASE_URL=
TWENTY_API_KEY=
TWENTY_REFERRAL_SECRET=
# Enable only after the watcher-agents Twenty app has installed its custom fields and SalesReferral object.
TWENTY_APP_FIELDS_ENABLED=false

# Newsletter inputs remain disabled until a webhook is configured.
NEWSLETTER_VISIBLE=false
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
